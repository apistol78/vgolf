	<text>
	<![CDATA[
#using \{218D113A-66DC-9049-8424-701FF60F2BC4}

MC_Logo_Scaf = MC_Logo_Scaf or class("MC_Logo_Scaf", Scaffolding)

function MC_Logo_Scaf:setup(frame)
	local ct = Container(frame, TableLayout({ 100 }, { 100 }, 16, 16, 16, 16))

	Image(ct, "MC_Logo")
		:setHorizontalAlign(Widget.ALIGN_CENTER)
		:setVerticalAlign(Widget.ALIGN_CENTER)


end

function MC_Logo_Scaf:getResourceKits()
	return { "\{5163A86B-BA43-4F76-9530-3B2C6A8C1116}", "\{5ABEAE05-EB26-934F-932F-7F3C7C582383}" }
end

	]]>
