<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text>
	<![CDATA[
OutOfBounds = OutOfBounds or class("OutOfBounds", traktor.world.ScriptComponent)

function OutOfBounds:new()
	-- Must have new for ScriptComponent will fail otherwise.

	self._ballEntity = nil

end

function OutOfBounds:update(contextObject, totalTime, deltaTime)
	-- Must have an update otherwise ScriptComponent will recurse oom.

	-- Only valid in runtime.
	if contextObject == nil then
		return
	end

	-- Lazy get ball entity.
	if self._ballEntity == nil then
		self._ballEntity = contextObject.world:getEntity("Ball")
		assert(self._ballEntity ~= nil)
	end

	-- Check if ball is inside OOB volume.
	local vc = self.owner:getComponent(traktor.world.VolumeComponent)
	local pt = self._ballEntity.transform.translation
	if vc:inside(pt) then
		contextObject:instantDeath()
	end
end

	]]>
	</text>
</object>
