<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text>
	<![CDATA[
#using \{7947759C-88DB-794E-8D09-7F30A40B6669}

LoadingView = LoadingView or class("LoadingView", Container)

LoadingView.__flipboardId = "LOADING"

function LoadingView:new(parent)
	Container.new(self, parent, FloodLayout())

	local ct = Panel(self, FloodLayout(50, 50))
		:setVerticalAlign(Widget.ALIGN_CENTER)
		:setHorizontalAlign(Widget.ALIGN_CENTER)

	self._lbl = Static(ct, "Loading...")
		:setTextSize(60)
end

	]]>
	</text>
</object>
