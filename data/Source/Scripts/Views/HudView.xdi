<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text>
	<![CDATA[
#using \{7947759C-88DB-794E-8D09-7F30A40B6669}

HudView = HudView or class("HudView", Container)

HudView.__flipboardId = "HUD"

function HudView:new(parent)
	Container.new(self, parent, TableLayout({ 100 }, { 0, 100, 0 }, 0, 0, 0, 0))

	local cttop = Container(self, TableLayout({ 0 }, { 0 }, 32, 32, 0, 0))
	self._buttonOptions = Button(cttop, "MC_Icon_Options")

	self._ctbanner = Container(self, TableLayout({ 100 }, { 0, 0 }, 0, 60, 0, 10))

	self._stbanner1 = Static(self._ctbanner, "")
		:setTextDropShadowColor(Color4f(0, 0, 0, 0.4))
		:setTextSize(60)
		:setHorizontalAlign(Widget.ALIGN_CENTER)

	self._stbanner2 = Static(self._ctbanner, "")
		:setTextDropShadowColor(Color4f(0, 0, 0, 0.4))
		:setTextSize(40)
		:setHorizontalAlign(Widget.ALIGN_CENTER)

	local ct1 = Container(self, FloodLayout(0, 0))

	Image(ct1, "MC_Icon_Score", Image.MODE_STRETCH)
	
	local pn = Container(ct1, FloodLayout(30, 30))

	self._imgGauge = Image(pn, "MC_Gauge", Image.MODE_DEFAULT)
		:setHorizontalAlign(Widget.ALIGN_LEFT)
		:setVerticalAlign(Widget.ALIGN_TOP)

	self._lblCoins = Static(pn, "0/0", false)
		:setTextSize(60)
		:setHorizontalAlign(Widget.ALIGN_LEFT)
		:setVerticalAlign(Widget.ALIGN_BOTTOM)

	self._lblStrike = Static(pn, "0", false)
		:setTextSize(100)
		:setHorizontalAlign(Widget.ALIGN_CENTER)
		:setVerticalAlign(Widget.ALIGN_CENTER)

	local ctTime = Container(pn, TableLayout({ 100 }, { 0, 0 }, 0, 0, 0, 2))
		:setHorizontalAlign(Widget.ALIGN_RIGHT)
		:setVerticalAlign(Widget.ALIGN_BOTTOM)

	self._lblTimeRecord = Static(ctTime, "0:00:00", false)
		:setHorizontalAlign(Widget.ALIGN_CENTER)
		:setTextSize(20)

	self._lblTime = Static(ctTime, "0:00:00", false)
		:setHorizontalAlign(Widget.ALIGN_CENTER)
		:setTextSize(40)
end

function HudView:showBestTime(bestTime)
	self._lblTimeRecord:setText(formatTime(bestTime))
end

function HudView:showStats(strikes, time, speed, coins, coinCount)
--	self._lblSpeed:setText(string.format("%.1f", speed))
	self._lblCoins:setText(string.format("%d/%d", coins, coinCount))
	self._lblStrike:setText(strikes)
	self._lblTime:setText(formatTime(time))
end

function HudView:showMessage(title, message)
	self._stbanner1:setText(title)
	self._stbanner2:setText(message)
	self._ctbanner:layout()

	-- Fade off banner.
	Tween(2, 0, 4, function(v, e)
		self._ctbanner:setAlpha(math.min(v, 1))
	end)
end

	]]>
	</text>
</object>
