<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text>
	<![CDATA[
Handle = Handle or {}

Handle_meta = {}
Handle_meta.__index = function(table, key)
	local handle = traktor.render.IRenderSystem.getParameterHandle(key)
	Handle[key] = handle
	return handle
end

setmetatable(Handle, Handle_meta)
	]]>
	</text>
</object>
