<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
	
#using \{FC4400A2-BDB6-BA45-9A22-12B9676E71FA}

function setupStyles()
	Static:setStyle("text", Color4f(1, 1, 1, 1))
	Static:setStyle("textSize", 22)
	Slider:setStyle("background", traktor.Color4f(1, 1, 1, 1))
	Slider:setStyle("knob", traktor.Color4f(0.2, 0.2, 0.4, 1))
	CheckBox:setStyle("background", traktor.Color4f(1, 1, 1, 1))
	PushButton:setStyle("background", traktor.Color4f(0.5, 0.7, 0.9, 1))
	PushButton:setStyle("textSize", 25)
	ListBox:setStyle("text",Color4f(1, 1, 1, 1))
	ListBox:setStyle("textHover", Color4f(0.6, 0.8, 1.0, 1.0))
	ListBox:setStyle("textSize", 20)
	DropDown:setStyle("background", traktor.Color4f(1, 1, 1, 1))
	DropDown:setStyle("list", traktor.Color4f(1, 1, 1, 1))
	DropDown:setStyle("textListHover", traktor.Color4f(0.8, 0.8, 0.8, 1.0))
	DropDown:setStyle("textSize", 22)
	DropDown:setStyle("textListSize", 22)
end

function formatTime(time)
	if time ~= nil then
		local tsec = math.floor(time)
		local tmin = math.floor(tsec / 60)
		local tmsc = math.floor((time - tsec) * 100)
		return string.format("%d:%02d:%02d", tmin, tsec % 60, tmsc)
	end
	return ""
end

function clamp(v, mn, mx)
	if v < mn then return mn end
	if v > mx then return mx end
	return v
end

function angleWrap(a)
	local twopi < const > = math.pi * 2
	while a < 0 do a = a + twopi end
	while a > twopi do a = a - twopi end	
	return a
end

function angleDifference(a, b)
	local pi < const > = math.pi
	local twopi < const > = pi * 2

	a = angleWrap(a)
	b = angleWrap(b)

	local d = b - a
	while d > pi do d = d - twopi end
	while d < -pi do d = d + twopi end
	return d
end

	
	]]></text>
</object>
