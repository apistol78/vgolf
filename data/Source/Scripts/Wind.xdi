<?xml version="1.0" encoding="utf-8"?>
<object type="traktor.script.Script" version="2">
	<text><![CDATA[
	
Wind = Wind or class("Wind", traktor.world.ScriptComponent)

function Wind:new()
	-- Must have new for ScriptComponent will fail otherwise.
end

function Wind:update(contextObject, totalTime, deltaTime)
	-- Must have an update otherwise ScriptComponent will recurse oom.

	local vc = self.owner:getComponent(traktor.world.VolumeComponent)
	local dir = self.owner.transform.axisZ * -0.3

	-- Add wind force to all dynamic bodies within volume.
	local pm = environment.physics.physicsManager
	for i, body in pairs(pm.bodies) do
		if not body.static and body.active then
			local p = body.transform.translation
			if vc:inside(p) then
				body:addForceAt(p, dir, false)
			end
		end
	end
end

	
	]]></text>
</object>
